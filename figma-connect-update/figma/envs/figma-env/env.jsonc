{
  /**
   * standardize your component dependencies.
   * @see https://bit.dev/docs/react-env/dependencies
   **/
  "policy": {
    /**
     * peer dependencies for components using that env.
     */
    "peers": [
      {
        "name": "react",
        /* the version to be installed and used by the env */
        "version": "^18.3.0",
        /* the range of versions this env's components are compatible with */
        "supportedRange": "^17.0.0 || ^18.0.0"
      },
      {
        "name": "vite",
        "version": "^5.3.5",
        "supportedRange": "^5.3.5"
      },
      {
        "name": "vitest",
        "version": "^2.0.4",
        "supportedRange": "^2.0.4"
      },
      {
        "name": "@vitest/coverage-v8",
        "version": "^2.0.4",
        "supportedRange": "^2.0.4"
      },
      {
        "name": "jsdom",
        "version": "^24.0.0",
        "supportedRange": "^24.0.0"
      },
      {
        "name": "react-dom",
        "version": "^18.3.0",
        "supportedRange": "^17.0.0 || ^18.0.0"
      },
      {
        "name": "react-router-dom",
        "version": "^6.26.0",
        "supportedRange": "^6.26.0"
      },
      {
        "name": "graphql",
        "version": "^16.8.1",
        "supportedRange": "^16.8.1"
      },
      {
        "name": "@apollo/client",
        "version": "^3.8.8",
        "supportedRange": "^3.8.8"
      },
      {
        "name": "@mdx-js/react",
        "version": "1.6.22",
        "supportedRange": "^1.6.22"
      },
      {
        "name": "@teambit/mdx.ui.mdx-scope-context",
        "version": "1.1.1",
        "supportedRange": "^1.0.0"
      },
      {
        "name": "webpack",
        "version": "^5.88.2",
        "supportedRange": "^5.88.2"
      },
      {
        "name": "eslint-plugin-import",
        "version": "2.29.1",
        "supportedRange": "2.29.1"
      },
      {
        "name": "eslint-plugin-jest",
        "version": "27.6.3",
        "supportedRange": "27.6.3"
      },
      {
        "name": "eslint-plugin-jsx-a11y",
        "version": "6.8.0",
        "supportedRange": "6.8.0"
      },
      {
        "name": "eslint",
        "version": "8.56.0",
        "supportedRange": "^8.56.0"
      },
      {
        "name": "@types/eslint",
        "version": "8.56.0",
        "supportedRange": "^8.56.0"
      },
      {
        "name": "eslint-plugin-mdx",
        "version": "^1.17.1",
        "supportedRange": "^1.17.1"
      },
      {
        "name": "eslint-plugin-react",
        "version": "7.33.2",
        "supportedRange": "7.33.2"
      },
      {
        "name": "eslint-plugin-react-hooks",
        "version": "4.6.2",
        "supportedRange": "4.6.2"
      },
      {
        "name": "@typescript-eslint/parser",
        "supportedRange": "^6.19.1",
        "version": "6.19.1"
      },
      {
        "name": "@typescript-eslint/eslint-plugin",
        "supportedRange": "^6.19.1",
        "version": "6.19.1"
      },
      {
        "name": "pino-pretty",
        "version": "4.5.0",
        "supportedRange": "4.5.0"
      },
      {
        "name": "@mdx-js/mdx",
        "version": "^1.6.22",
        "supportedRange": "^1.6.22"
      },
      {
        "name": "sass",
        "version": "^1.69.5",
        "supportedRange": "^1.69.5"
      },
      {
        "name": "browserslist",
        "version": "4.23.0",
        "supportedRange": "4.23.0"
      },
      {
        "name": "@types/node",
        "version": "20.12.10",
        "supportedRange": "^20.12.10"
      },
      {
        "name": "@types/react",
        "version": "18.3.0",
        "supportedRange": "^18.3.0"
      },
      {
        "name": "@types/react-dom",
        "version": "^18.3.0",
        "supportedRange": "^18.3.0"
      },
      {
        "name": "@types/jest",
        "version": "^29.2.2",
        "supportedRange": "^29.2.2"
      },
      {
        "name": "@types/find-root",
        "version": "^1.1.4",
        "supportedRange": "^1.1.4"
      },
      {
        "name": "@testing-library/react",
        "version": "^16.0.0",
        "supportedRange": "^16.0.0"
      },
      {
        "name": "@testing-library/jest-dom",
        "version": "6.4.8",
        "supportedRange": "~6.4.8"
      },
      {
        "name": "@testing-library/dom",
        "version": "10.4.0",
        "supportedRange": "10.4.0"
      },
      {
        "name": "@figma/code-connect",
        "version": "^1.5.1",
        "supportedRange": "^1.2.4"
      }
    ],
    /**
     * dev dependencies for components using that env
     */
    "dev": [
      // {
      //   "name": "@types/testing-library__jest-dom",
      //   "version": "^5.9.5",
      //   "force": true
      // }
      {
        "name": "@figma/plugin-typings",
        "version": "^1.132.0",
        "force": true
      }
    ]
  },
  /**
   * associate files with a specific dev service.
   * associated files are considered as dev files.
   * @see https://bit.dev/docs/react-env/dependencies#configure-files-as-dev-files
   **/
  "patterns": {
    /**
     * files to be loaded and displayed in the 'preview' tab.
     * @see https://bit.dev/docs/react-env/component-previews
     */
    "compositions": [
      "**/*.composition.*",
      "**/*.preview.*"
    ],
    /**
     * files to be loaded and displayed in the 'overview' tab.
     * @see https://bit.dev/docs/react-env/component-docs
     */
    "docs": [
      "**/*.docs.*"
    ],
    /* files to be included in the component testing */
    "tests": [
      "**/*.spec.*",
      "**/*.test.*"
    ]
  }
}