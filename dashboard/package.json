{
  "name": "@egdata/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4002",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply egdata-dashboard-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply egdata-dashboard-db --remote --config wrangler.migrations.jsonc"
  },
  "dependencies": {
    "@scalar/api-reference-react": "^0.9.88",
    "@tanstack/react-router": "^1.132.2",
    "hono": "4.12.18",
    "lucide-react": "^0.517.0",
    "react": "19.2.6",
    "react-aria-components": "^1.14.0",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^0.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.6",
    "@cloudflare/workers-types": "^4.20260405.0",
    "@react-aria/optimize-locales-plugin": "^1.1.0",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-plugin": "^1.132.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "4.3.0",
    "tailwindcss-react-aria-components": "^2.0.1",
    "tw-animate-css": "^1.2.9",
    "typescript": "5.9.3",
    "vite": "^7.1.5",
    "vitest": "^2.1.9",
    "wrangler": "^4.90.1"
  }
}
