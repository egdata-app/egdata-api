# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
FROM rust:1.95.0-alpine AS chef
RUN apk add --no-cache build-base cmake clang lld perl tzdata pkgconf openssl-dev openssl-libs-static
COPY --from=lukemathwalker/cargo-chef:0.1.78-rust-alpine /usr/local/cargo/bin/cargo-chef /usr/local/cargo/bin/cargo-chef
WORKDIR /app/rust
ENV OPENSSL_STATIC=1 \
    RUSTUP_TOOLCHAIN=1.95.0

FROM chef AS planner
COPY rust/ .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/rust/recipe.json recipe.json
RUN target="$(rustc -vV | sed -n 's/^host: //p')" && \
    RUSTFLAGS="-C target-feature=+crt-static -C link-arg=-fuse-ld=lld" \
    cargo chef cook --release --locked --target "$target" --recipe-path recipe.json -p egdata-api --bin egdata-api

WORKDIR /app
COPY rust/ rust/
COPY openapi/ openapi/
COPY src/static/ src/static/
COPY src/graphql/typedefs.ts src/graphql/typedefs.ts
WORKDIR /app/rust
RUN target="$(rustc -vV | sed -n 's/^host: //p')" && \
    RUSTFLAGS="-C target-feature=+crt-static -C link-arg=-fuse-ld=lld" \
    cargo build --release --locked --target "$target" -p egdata-api --bin egdata-api && \
    mkdir /artifacts && cp "target/$target/release/egdata-api" /artifacts/ && \
    ! readelf -l /artifacts/egdata-api | grep -q 'Requesting program interpreter'

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/share/zoneinfo/ /usr/share/zoneinfo/
COPY --from=builder /artifacts/ /usr/local/bin/
COPY openapi/egdata.openapi.json openapi/egdata.v1.openapi.json /app/openapi/
WORKDIR /app
USER 65532:65532
ENV NODE_ENV=production PORT=4000 ORIGIN_AUTH_REQUIRED=true
EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD ["/usr/local/bin/egdata-api", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/egdata-api"]
CMD ["--bind","0.0.0.0"]
