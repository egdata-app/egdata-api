{
  "id": "v1-profile-filters-and-offer-expiry",
  "recordedDate": "2026-11-19",
  "title": "Add profile games completion filter and offer expiryDate to v1 responses",
  "endpoints": [
    {
      "apiVersion": "v1",
      "operationId": "listProfileGames",
      "method": "GET",
      "path": "/v1/profiles/{id}/games",
      "type": "changed",
      "compatibility": "compatible",
      "before": "Supported `sort` and boolean `platinum` filtering on `GET /v1/profiles/{id}/games`.",
      "after": "Adds optional `filter` query parameter (`all`, `completed`, `near-platinum`, `in-progress`, `platinum`; default `all`) with cursor bindings, cache keys, and total counts scoped by the effective filter while preserving `platinum=true` backward compatibility.",
