{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://egdata.app/schemas/change-record.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "recordedDate", "title", "endpoints", "verification"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "recordedDate": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 8, "maxLength": 160 },
    "corrects": { "type": "string", "minLength": 1 },
    "verification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5 }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "operationId",
          "method",
          "path",
          "type",
          "compatibility",
          "before",
          "after",
          "clientAction"
        ],
        "properties": {
          "apiVersion": { "enum": ["legacy", "v1"] },
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "method": {
            "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
          },
          "path": { "type": "string", "pattern": "^/[^*?:]*$" },
          "type": {
            "enum": [
              "added",
              "changed",
              "fixed",
              "deprecated",
              "removed",
              "security"
            ]
          },
          "compatibility": { "enum": ["compatible", "breaking"] },
          "before": { "type": "string", "minLength": 8 },
          "after": { "type": "string", "minLength": 8 },
          "clientAction": { "type": "string", "minLength": 4 },
          "schemaFields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "replaces": { "type": "string", "minLength": 1 },
          "replacement": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
